 "comparisons_text": {
  "industrial_vs_manufacturing": {
   "differences": [
    "The EIA industrial class is a class of service, not NAICS manufacturing: it includes agriculture and irrigation from 2003 (Table 7.6 footnote d), and its other members are not stated in the retained material.",
    "Retail sales leave out electricity generated and used on site. Table 7.6's direct use is one aggregate, not split by sector; its net change cannot show industrial self-generation, because its parts may offset."
   ],
   "eia_measure": "EIA Table 7.6: electricity sales to ultimate customers, industrial class (ESICPUS), million kWh, not seasonally adjusted; a fourth quarter is the October-December total.",
   "g17_measure": "G.17 Table 1: Manufacturing (NAICS 31-33), percent change of a seasonally adjusted output index, as printed.",
   "link": {
    "label": "Electricity by sector (EIA Table 7.6)",
    "section": "electricity"
   },
   "link_g17": {
    "label": "Industries and revisions (G.17)",
    "section": "g17"
   },
   "possibilities": [
    "Industry mix: industries' electricity use per unit of output differs, so the two can diverge when composition changes.",
    "Weather: cooling and irrigation loads can change electricity purchases without any change in factory output.",
    "On-site generation: more or less self-generation can change purchases for the same use.",
    "Changes among customers in the industrial class outside manufacturing."
   ],
   "possibilities_note": "Possibilities only: these observations do not establish any of them.",
   "question": "When retail electricity sales to the industrial class change, did manufacturing output change in the same direction over the same period?",
   "title": "Industrial electricity retail sales and manufacturing output"
  },
  "utility_output_and_customers": {
   "differences": [
    "The customer breakdown decomposes EIA total retail sales only. It does not show which customers drove the change in G.17 utility output, and the two are shown side by side, not reconciled.",
    "Utility output and retail sales measure different things; how far they differ in any period (for example through losses, wholesale trade or own use) is not measured here."
   ],
   "eia_measure": "EIA Table 7.6: total retail sales (ESTCPUS) and its four customer classes, million kWh, not seasonally adjusted.",
   "g17_measure": "G.17 Table 1: Utilities / Electric (NAICS 2211), percent change of a seasonally adjusted output index, as printed.",
   "link": {
    "label": "Electricity by sector (EIA Table 7.6)",
    "section": "electricity"
   },
   "link_g17": {
    "label": "Industries and revisions (G.17)",
    "section": "g17"
   },
   "possibilities": [],
   "possibilities_note": null,
   "question": "When electric utility output changes, how did EIA retail sales change by customer class over the same period?",
   "title": "Electric utility output and the customer breakdown of electricity retail sales"
  }
 },
