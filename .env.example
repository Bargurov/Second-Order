# Placeholder-only template. Copy this file to .env for the current local app flow.
# The frontend does not currently require its own env vars.
# Cloud deploys use the same keys below. The host injects PORT automatically.

# Optional for the API. Required only for real model-backed analysis.
# If omitted, the backend uses a mock fallback response for local analysis flows.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM provider controls.
# ANALYSIS_PROVIDER controls normal /analyze calls. BACKFILL_PROVIDER controls
# POST /movers/backfill-recent independently so backfills can use a cheaper model.
ANALYSIS_PROVIDER=anthropic
BACKFILL_PROVIDER=openai

# Main /analyze model. Keep this explicit so caches and persisted rows share
# the same model key; blank falls back to the code default.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini

# Cheaper model used only by POST /movers/backfill-recent when it must run
# fresh analysis. Regular /analyze calls continue to use ANALYSIS_PROVIDER.
BACKFILL_MODEL=gpt-4o-mini

# Backfill safety defaults. A backfill is a dry run unless the request passes
# dry_run=false. The route rejects requests that omit max_llm_calls, and the
# requested value must be <= MAX_BACKFILL_LLM_CALLS. Keep this low.
MAX_BACKFILL_LLM_CALLS=1
BACKFILL_DRY_RUN_DEFAULT=true

# Headline registry low-impact expiry. Active live surfaces
# (/movers/today, /events listing) hide low-impact analyzed events
# whose analyzed_at is older than this many days. Default 5.
HEADLINE_REGISTRY_LOW_IMPACT_TTL_DAYS=5

# -----------------------------------------------------------------
# Deployed-runtime CORS
# -----------------------------------------------------------------
# Controls the FastAPI CORS middleware. See api._resolve_cors_origins
# for the parsing rules.
#
#   unset / empty -> no CORS middleware (same-origin deploys, local dev)
#   *              -> wildcard; disables credentialed requests
#   comma list     -> exact-origin allowlist with credentials enabled
#
# Example for a split-origin deploy:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# Required only if you run the Telegram bot. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# FastAPI base URL the Telegram bot calls. Defaults to http://127.0.0.1:8000
# for local runs — leave blank unless deploying the bot against a remote API.
# Example: SECOND_ORDER_API_URL=https://your-api.example.com
SECOND_ORDER_API_URL=

# Optional scheduled morning brief. Enable only when all three are set.
DAILY_BRIEF_ENABLED=false
DAILY_BRIEF_CHAT_ID=your_telegram_chat_id_here
DAILY_BRIEF_TIME=08:00

# Optional watchlist alerts from saved-event tickers.
WATCHLIST_ENABLED=false
WATCHLIST_CHAT_ID=your_telegram_chat_id_here
WATCHLIST_INTERVAL_MIN=30
WATCHLIST_THRESHOLD_PCT=3.0

# Optional market-data provider override for the API.
# Leave blank to use the app default.
# Set to "polygon" and provide POLYGON_API_KEY to use Polygon.io REST API.
# Falls back to yfinance if the key is missing or invalid.
MARKET_DATA_PROVIDER=
POLYGON_API_KEY=your_polygon_api_key_here

# Optional background refresh of liquid market snapshots used by
# macro / market-context / movers endpoints.
# Disabled by default so test runs do not start background work.
MARKET_SNAPSHOTS_ENABLED=false
MARKET_SNAPSHOTS_INTERVAL=60
